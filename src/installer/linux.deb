# Nanna Linux .deb Installer Configuration
# This file defines the .deb packaging manifest for the bundled daemon sidecar installer

[installer]
name = "Nanna"
version = "0.2.1"
publisher = "Basic Automation"
description = "Personal AI presence — local-first, always-on"
display_name = "Nanna Personal AI"

[paths]
install_dir = "/opt/nanna"
uninstall_dir = "/usr/share/applications"
desktop_file = "/usr/share/applications/nanna.desktop"
daemon_path = "/opt/nanna/bin/nanna-daemon"
app_path = "/opt/nanna/bin/nanna"

[components]
main_app = { path = "nanna", description = "Nanna Application" }
daemon = { path = "nanna-daemon", description = "Nanna Daemon (background service)" }
tools = { path = "tools/", description = "Tool scripts" }
config = { path = "config/", description = "User configuration" }

[features]
launch_at_login = true
system_tray = true
auto_update = true

[daemon_sidecar]
enabled = true
auto_start = true
health_check_interval = "30s"
reconnect_timeout = "10s"

[uninstall]
remove_data = false
preserve_config = true
